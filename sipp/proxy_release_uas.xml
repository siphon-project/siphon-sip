<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  proxy.release, callee side (TS 24.229 §5.2.8.1.2).

  INVITE → 200 → ACK → BYE from siphon → 200

  The BYE is siphon's, built from the dialog it stored: CSeq one above the
  last request the caller sent in the dialog (its INFO, CSeq 2), so 3, and the
  script's Reason.
-->
<scenario name="proxy.release UAS">

  <recv request="INVITE" crlf="true" />

  <send retrans="500">
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_Record-Route:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:bob@[local_ip]:[local_port];transport=[transport]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=bob 53655765 2353687637 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 0
a=rtpmap:0 PCMU/8000
]]>
  </send>

  <recv request="ACK" crlf="true" />

  <recv request="BYE" timeout="10000">
    <action>
      <ereg regexp="cause=503" search_in="hdr" header="Reason:"
            check_it="true" assign_to="reason" />
      <ereg regexp="^ *3 BYE" search_in="hdr" header="CSeq:"
            check_it="true" assign_to="cseq" />
      <ereg regexp="SIPpTag01" search_in="hdr" header="To:"
            check_it="true" assign_to="callee_tag" />
    </action>
  </recv>

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

  <Reference variables="reason,cseq,callee_tag" />

</scenario>
