<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- A parallel-fork branch that answers 503 at once (sipp/b2bua-fork/b2bua_fork.py).

     A 503 says this one server is unavailable, which RFC 3261 §16.7 step 6 ranks
     below every other failure and never sends upstream as such. The ACK row is
     §17.1.1.3: the branch is owed it whichever response the caller ends up
     getting. -->

<scenario name="B2BUA fork branch that is unavailable (503)">

  <recv request="INVITE" />

  <send>
    <![CDATA[
SIP/2.0 503 Service Unavailable
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Retry-After: 30
Content-Length: 0

]]>
  </send>

  <recv request="ACK" crlf="true" />

</scenario>
