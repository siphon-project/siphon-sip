<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- A parallel-fork branch that is busy at once. The ACK row is RFC 3261
     §17.1.1.3: siphon owes this branch its ACK even while a sibling branch is
     still ringing, which is exactly when it used to fail the whole call and
     forget the rest (sipp/b2bua-fork/b2bua_fork.py). -->

<scenario name="B2BUA fork branch that is busy">

  <recv request="INVITE" />

  <send>
    <![CDATA[
SIP/2.0 486 Busy Here
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

  <recv request="ACK" crlf="true" />

</scenario>
