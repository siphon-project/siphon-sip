<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  B2BUA UAS scenario:
  Receive INVITE → 180 → 200 → ACK → BYE → 200

  This is the B-leg side. The B2BUA generates a new INVITE with its own
  Via, so we won't see the UAC's Via or Record-Route.
-->
<scenario name="INFO relay: B2BUA call UAS">

  <!-- Receive INVITE from B2BUA (B-leg) -->
  <recv request="INVITE" crlf="true" />

  <!-- Send 180 Ringing -->
  <send>
    <![CDATA[
SIP/2.0 180 Ringing
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:bob@[local_ip]:[local_port];transport=[transport]>
Content-Length: 0

]]>
  </send>

  <!-- Brief pause before answering -->
  <pause milliseconds="200" />

  <!-- Send 200 OK with SDP -->
  <send retrans="500">
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:bob@[local_ip]:[local_port];transport=[transport]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=bob 53655765 2353687637 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 0 8 101
a=rtpmap:0 PCMU/8000
a=rtpmap:8 PCMA/8000
a=rtpmap:101 telephone-event/8000
a=fmtp:101 0-15
]]>
  </send>

  <!-- Receive ACK from B2BUA -->
  <recv request="ACK" optional="true" timeout="5000" />

  <!-- The INFO, relayed from the A-leg. Its body has to survive the relay:
       siphon surfacing the digit to its own handlers is no substitute for the
       far party receiving it, and a relay that dropped the body would still
       complete every other message in this call. -->
  <recv request="INFO" crlf="true">
    <action>
      <ereg regexp="Signal=5"
            search_in="body"
            check_it="true"
            assign_to="relayed_signal" />
      <log message="relayed INFO carries the digit: [$relayed_signal]" />
    </action>
  </recv>

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

  <!-- Receive BYE from B2BUA -->
  <recv request="BYE" />

  <!-- Send 200 OK for BYE -->
  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

</scenario>
