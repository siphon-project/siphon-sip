<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- LCR route sequence in sipp-b2bua-lcr, carrier A: answers 503, a default
     reroute cause, with no provisional before it, so the sequence fails over
     to carrier B.

     The INVITE must carry the route's number policy (plain digits in the
     Request-URI, From and To, where the caller sent +E.164): that shaping is
     what makes the B-leg identity differ from the caller's own. `<sip:1555…`
     cannot match a `+`-prefixed number. The ACK siphon owes the 503
     (RFC 3261 §17.1.1.3) is mandatory, and with -timeout_error a missing one
     fails the run. -->

<scenario name="B2BUA LCR carrier A (503)">

  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="INVITE sip:15550100002@" search_in="msg" check_it="true" assign_to="shaped_request_uri" />
      <ereg regexp="&lt;sip:15550100001@" search_in="hdr" header="From:" check_it="true" assign_to="shaped_from" />
      <ereg regexp="&lt;sip:15550100002@" search_in="hdr" header="To:" check_it="true" assign_to="shaped_to" />
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[
SIP/2.0 503 Service Unavailable
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTagA[call_number]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

  <recv request="ACK" timeout="10000" />

  <Reference variables="shaped_request_uri,shaped_from,shaped_to" />

</scenario>
