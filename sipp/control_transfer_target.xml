<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  The party a `control-transfer` case brings into the call: the Refer-To target
  of the `refer-callee` case, and the contact of the AoR that answers in the
  `replace-aor` case.

  recv INVITE -> 180 -> (1 s) -> 200 -> recv ACK -> (1.5 s) -> BYE -> 200

  It is rung as an ordinary call and shown the caller it is about to talk to.
  It then hangs up, and siphon answering that BYE and ending the caller is what
  proves the promotion happened: the BYE has to reach the party that survived,
  not the one that was replaced.

  The second of ringing is the window in which the `replace-aor` case's other
  contact is still ringing too, so the CANCEL that contact gets is one siphon
  sent because this one answered.

  The INVITE's Call-ID is echoed to the container's output for the runner to
  compare (sipp/control/run_transfer_case.sh).
-->
<scenario name="control-transfer party brought into the call">

  <recv request="INVITE" crlf="true" timeout="40000">
    <action>
      <ereg regexp="[^[:space:]]+" search_in="hdr" header="Call-ID:" assign_to="wire_call_id" />
      <ereg regexp="tag=([^;>[:space:]]+)" search_in="hdr" header="From:" assign_to="junk_tag,remote_tag" />
      <ereg regexp="&lt;([^>]+)>" search_in="hdr" header="From:" assign_to="junk_from,remote_uri" />
      <ereg regexp="&lt;([^>]+)>" search_in="hdr" header="To:" assign_to="junk_to,local_uri" />
      <ereg regexp="&lt;([^>]+)>" search_in="hdr" header="Contact:" assign_to="junk_contact,remote_contact" />
      <ereg regexp="12025550101" search_in="hdr" header="From:" check_it="true"
            assign_to="caller_shown" />
      <exec command="echo WIRE-CALL-ID [$wire_call_id]" />
      <log message="rung for [$caller_shown] ([$junk_tag][$junk_from][$junk_to][$junk_contact])" />
    </action>
  </recv>

  <send>
    <![CDATA[
SIP/2.0 180 Ringing
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag02[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:target@[local_ip]:[local_port];transport=[transport]>
Content-Length: 0

]]>
  </send>

  <pause milliseconds="1000" />

  <send retrans="500">
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag02[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:target@[local_ip]:[local_port];transport=[transport]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=target 53655765 2353687637 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 8
a=rtpmap:8 PCMA/8000
a=ptime:20
]]>
  </send>

  <recv request="ACK" timeout="5000" />

  <pause milliseconds="1500" />

  <send retrans="500">
    <![CDATA[
BYE [$remote_contact] SIP/2.0
Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
From: <[$local_uri]>;tag=[pid]SIPpTag02[call_number]
To: <[$remote_uri]>;tag=[$remote_tag]
Call-ID: [$wire_call_id]
CSeq: 1 BYE
Contact: <sip:target@[local_ip]:[local_port];transport=[transport]>
Max-Forwards: 70
User-Agent: SIPp/control-transfer-target
Content-Length: 0

]]>
  </send>

  <recv response="200" crlf="true" />

</scenario>
