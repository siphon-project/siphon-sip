<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- The upstream registrar siphon registers a trunk with.

     Proves the outbound half of RFC 3261 §10.2.2: when the trunk is removed,
     siphon clears the binding it holds here with an `Expires: 0` REGISTER,
     instead of dropping its own state and leaving this registrar offering
     calls to a trunk that is gone until the granted Expires runs out.

     Before the `Expires: 0`, siphon fetches the bindings (RFC 3261 §10.2.3: a
     REGISTER with no Contact and no Expires) and clears its binding only when
     the 2xx lists its own Contact, so it never clears another node's binding at
     a registrar that keeps one binding per AoR. This registrar lists the
     Contact the trunk registered.

     All the REGISTERs arrive on one Call-ID, because a de-registration belongs
     to the registration it clears (§10.2.4) — which is also what this asserts
     by receiving them in a single SIPp call. -->
<scenario name="Upstream registrar: a registration, then its de-registration">

  <!-- The initial REGISTER for the configured trunk. -->
  <recv request="REGISTER">
    <action>
      <!-- Not a de-registration: the binding has to exist before clearing it
           can mean anything. No `^` anchor — the sipp in CI does not match one
           against a header value. -->
      <ereg regexp="Expires: [1-9]" search_in="msg" check_it="true"
            assign_to="initial_expires" />
      <!-- Referenced so sipp does not abort: it refuses a variable that is
           assigned and never used. -->
      <log message="initial REGISTER carried Expires [$initial_expires]" />
      <!-- The Contact siphon registered, which the fetch's answer lists back. -->
      <ereg regexp="sip:[^>;]*" search_in="hdr" header="Contact:"
            check_it="true" assign_to="bound_contact" />
      <log message="trunk registered [$bound_contact]" />
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <[$bound_contact]>;expires=3600
      Expires: 3600
      Content-Length: 0

    ]]>
  </send>

  <!-- The script removes the trunk once it is registered. The first request
       that puts on the wire is the fetch: same Call-ID, a higher CSeq, no
       Contact and no Expires. -->
  <recv request="REGISTER">
    <action>
      <ereg regexp="(Contact|Expires):" search_in="msg" check_it_inverse="true"
            assign_to="fetch_headers" />
      <log message="fetch carried no Contact or Expires [$fetch_headers]" />
    </action>
  </recv>

  <!-- The 2xx lists the trunk's own Contact, so the binding is its to clear. -->
  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <[$bound_contact]>;expires=3600
      Expires: 3600
      Content-Length: 0

    ]]>
  </send>

  <!-- Only then the `Expires: 0` REGISTER, on the same Call-ID and the CSeq
       after the fetch's, naming the Contact that was bound. -->
  <recv request="REGISTER">
    <action>
      <ereg regexp="Expires: 0" search_in="msg" check_it="true"
            assign_to="dereg_expires" />
      <ereg regexp="sip:[^>;]*" search_in="hdr" header="Contact:"
            check_it="true" assign_to="dereg_contact" />
      <log message="de-REGISTER of [$dereg_contact]" />
      <log message="de-REGISTER carried Expires [$dereg_expires]" />
    </action>
  </recv>

  <!-- Most carrier registrars challenge every REGISTER, a de-registration
       included (RFC 3261 §22). The removed trunk has to answer it, still with
       `Expires: 0`, or the binding stays until it expires. -->
  <send>
    <![CDATA[

      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="registrar.test", nonce="0123456789abcdef", algorithm=MD5, qop="auth"
      Content-Length: 0

    ]]>
  </send>

  <recv request="REGISTER">
    <action>
      <ereg regexp="Expires: 0" search_in="msg" check_it="true"
            assign_to="challenged_dereg_expires" />
      <ereg regexp="Authorization: Digest" search_in="msg" check_it="true"
            assign_to="challenged_dereg_auth" />
      <log message="challenged de-REGISTER carried Expires [$challenged_dereg_expires] and [$challenged_dereg_auth]" />
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Expires: 0
      Content-Length: 0

    ]]>
  </send>

  <ResponseTimeRepartition value="100, 500, 1000, 2000"/>
  <CallLengthRepartition value="1000, 5000, 10000, 20000"/>

</scenario>
