<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- The upstream registrar after the node was killed and restarted without the
     trunk in its list. The binding the dead process held is still here; the
     restarted siphon must fetch the bindings first (RFC 3261 §10.2.3: no
     Contact, no Expires) and, the 2xx listing its Contact (the one the first
     run registered, passed in as [$listed_contact]), clear it (§10.2.2) on the
     Contact and the Call-ID it was made with. The registrar challenges every
     REGISTER (§22), the fetch and the de-registration included, so the
     credential has to come from the source's lookup: nothing persisted it. -->
<scenario name="Upstream registrar: clearing the binding a killed node left">

  <Global variables="listed_contact" />

  <!-- The fetch, challenged. -->
  <recv request="REGISTER" />

  <send>
    <![CDATA[

      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="registrar.test", nonce="0123456789abcdef", algorithm=MD5, qop="auth"
      Content-Length: 0

    ]]>
  </send>

  <!-- The authorised fetch: its digest is verified against the trunk's
       password; the answer lists the binding the first run made. -->
  <recv request="REGISTER">
    <action>
      <ereg regexp="username=.line-user-7." search_in="hdr" header="Authorization:"
            check_it="true" assign_to="fetch_auth" />
      <verifyauth assign_to="fetchauthok" username="line-user-7" password="secret123" />
      <log message="authorised fetch carried [$fetch_auth]" />
    </action>
  </recv>

  <nop test="fetchauthok" next="fetch_accepted" />

  <send>
    <![CDATA[

      SIP/2.0 403 Forbidden
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- Never arrives: the call fails, so SIPp exits non-zero. -->
  <recv request="BYE" timeout="2000" />

  <label id="fetch_accepted" />

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: [$listed_contact]
      Content-Length: 0

    ]]>
  </send>

  <recv request="REGISTER">
    <action>
      <ereg regexp="Expires: 0" search_in="msg" check_it="true"
            assign_to="dereg_expires" />
      <ereg regexp="sip:[a-z0-9-]+@[0-9.]+:25060" search_in="hdr" header="Contact:"
            check_it="true" assign_to="dereg_contact" />
      <log message="de-REGISTER carried Expires [$dereg_expires] on Contact [$dereg_contact]" />
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="registrar.test", nonce="0123456789abcdef", algorithm=MD5, qop="auth"
      Content-Length: 0

    ]]>
  </send>

  <!-- The digest response is verified against the trunk's password (RFC 2617
       / 7616): a wrong credential from the lookup is answered 403 and fails
       the scenario. -->
  <recv request="REGISTER">
    <action>
      <ereg regexp="Expires: 0" search_in="msg" check_it="true"
            assign_to="retry_expires" />
      <ereg regexp="sip:[a-z0-9-]+@[0-9.]+:25060" search_in="hdr" header="Contact:"
            check_it="true" assign_to="retry_contact" />
      <ereg regexp="username=.line-user-7." search_in="hdr" header="Authorization:"
            check_it="true" assign_to="retry_auth" />
      <verifyauth assign_to="authok" username="line-user-7" password="secret123" />
      <log message="authorised de-REGISTER carried Expires [$retry_expires], Contact [$retry_contact] and [$retry_auth]" />
    </action>
  </recv>

  <nop test="authok" next="accepted" />

  <send>
    <![CDATA[

      SIP/2.0 403 Forbidden
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- Never arrives: the call fails, so SIPp exits non-zero. -->
  <recv request="BYE" timeout="2000" />

  <label id="accepted" />

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Expires: 0
      Content-Length: 0

    ]]>
  </send>

  <ResponseTimeRepartition value="100, 500, 1000, 2000"/>
  <CallLengthRepartition value="1000, 5000, 10000, 20000"/>

</scenario>
