<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- LCR route sequence in sipp-b2bua-lcr, the untried carrier of the progress
     case (callee +15550100003, routes.15550100003.json): the route after a
     carrier that shows progress, which siphon must never dial.

     SIPp creates a call only when a message arrives, so a UAS cannot count an
     INVITE that never comes. The service's entrypoint grades this scenario by
     SIPp's exit code instead:
       - no INVITE: SIPp exits 97 when its -timeout window ends with no call,
         and 97 is the only code that passes;
       - an INVITE: the receive below matches it, the next one times out and
         aborts the call, and SIPp exits straight away with a failure code
         (255 from this SIPp build);
       - SIPp that never ran, crashed or could not bind: any other code, which
         fails too. -->

<scenario name="B2BUA LCR untried carrier (must never be dialled)">

  <recv request="INVITE" />

  <!-- Nothing sends this; the timeout fails the call. -->
  <recv request="DIALLED_BUT_MUST_NOT_BE" timeout="100" />

</scenario>
