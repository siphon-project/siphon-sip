<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- A-leg caller for the settled carrier case in sipp-b2bua-lcr
     (sipp/b2bua-lcr/, run by run_case.sh).

     The callee +15550100004 is routed over routes.15550100004.json: a rejecting
     carrier and then a trying one, each with timeout_secs 3, under a ring bound
     of 6 s (b2bua_lcr.py). The rejecting carrier answers 503, so siphon dials
     the trying carrier, which answers only 100 and rings out at its own 3 s.
     That was the last carrier and neither carrier showed progress, so siphon
     fails the call. What this caller must see:
       - siphon's final failure, with the status the receive below names and
         nothing before it but an optional 100. The rejecting carrier's 503
         fails over rather than reaching the caller, and the stale 183 it sends
         after its 503 must be dropped: any 18x, or any other response, is
         unexpected here and fails the call;
       - that failure no earlier than 2.5 s and no later than 5.5 s after the
         INVITE. The ring bound would put it at 6 s.
     Whether the rejecting carrier was sent a CANCEL is graded on that carrier.
     The ACK echoes the failure's To, and siphon has to absorb it: run_case.sh
     fails the run if the failure reached this caller more than once. -->

<scenario name="B2BUA LCR caller (the last carrier rings out after one that failed)">

  <nop>
    <action>
      <gettimeofday assign_to="invited_seconds,invited_microseconds" />
    </action>
  </nop>

  <send retrans="500">
    <![CDATA[
INVITE sip:+15550100004@[remote_ip]:[remote_port] SIP/2.0
Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
From: <sip:+15550100001@example.com>;tag=[pid]SIPpTag00[call_number]
To: <sip:+15550100004@example.com>
Call-ID: [call_id]
CSeq: 1 INVITE
Contact: <sip:+15550100001@[local_ip]:[local_port];transport=[transport]>
Max-Forwards: 70
Content-Type: application/sdp
Content-Length: [len]

v=0
o=caller 1 1 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 0
a=rtpmap:0 PCMU/8000
]]>
  </send>

  <recv response="100" optional="true" />

  <!-- The status siphon fails the call with once its last carrier rings out
       with no carrier having shown progress. -->
  <recv response="503" timeout="11000">
    <action>
      <gettimeofday assign_to="answered_seconds,answered_microseconds" />
      <assign assign_to="elapsed" variable="answered_seconds" />
      <subtract assign_to="elapsed" variable="invited_seconds" />
      <assign assign_to="fraction" variable="answered_microseconds" />
      <subtract assign_to="fraction" variable="invited_microseconds" />
      <divide assign_to="fraction" value="1000000" />
      <add assign_to="elapsed" variable="fraction" />
      <test assign_to="too_early" variable="elapsed" compare="less_than" value="2.5" />
      <test assign_to="too_late" variable="elapsed" compare="greater_than" value="5.5" />
      <log message="final response after [$elapsed] s" />
    </action>
  </recv>
  <nop next="wrong_time" test="too_early" />
  <nop next="wrong_time" test="too_late" />

  <!-- RFC 3261 §17.1.1.3: the ACK's To is the response's, tag included. -->
  <send>
    <![CDATA[
ACK sip:+15550100004@[remote_ip]:[remote_port] SIP/2.0
Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
From: <sip:+15550100001@example.com>;tag=[pid]SIPpTag00[call_number]
[last_To:]
Call-ID: [call_id]
CSeq: 1 ACK
Max-Forwards: 70
Content-Length: 0

]]>
  </send>

  <!-- Stay in the call past the first three Timer G retransmissions (0.5 s,
       1.5 s and 3.5 s after the final response, RFC 3261 §17.2.1): an ACK
       siphon did not absorb shows as a retransmitted final response in this
       caller's counts. -->
  <pause milliseconds="4000" />
  <nop next="done" />

  <label id="wrong_time" />
  <nop>
    <action>
      <log message="WRONG TIME: the final response came [$elapsed] s after the INVITE, expected 2.5 to 5.5 s" />
    </action>
  </nop>
  <!-- Nothing sends this; the timeout fails the call. -->
  <recv request="WRONG_TIME" timeout="100" />

  <label id="done" />

</scenario>
