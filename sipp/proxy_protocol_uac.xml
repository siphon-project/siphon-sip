<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  PROXY protocol acceptance caller (sipp/docker-compose.proxy-protocol.yaml,
  driven by scripts/proxy_protocol_test.sh).

  This caller never talks to siphon directly. It sends to HAProxy, which
  terminates the connection and opens its own to siphon's `tls` listener with
  `send-proxy-v2`. So every address siphon could read off the socket is the
  front's, and the only place the caller's own address exists is the PROXY
  header.

  REGISTER first (so a binding is stored), then INVITE, whose 200 carries what
  each consumer inside siphon actually holds. All four must read this caller's
  address, 192.0.2.30 — the front is 192.0.2.20, and that is what they read if
  the substitution never reaches them.

  This SIPp build never matches a `^` anchor in a header regexp. So each check
  captures the whole header value, matches an END-anchored regexp against the
  same header, and compares the two: they differ when anything precedes the
  expected form. A mismatch jumps to address_mismatch, whose receive times out
  and fails the call.
-->
<scenario name="PROXY protocol caller (client address behind a front)">

  <send retrans="500">
    <![CDATA[
REGISTER sip:pbx.example SIP/2.0
Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
From: <sip:ua@pbx.example>;tag=[pid]SIPpTag00[call_number]
To: <sip:ua@pbx.example>
Call-ID: [call_id]
CSeq: 1 REGISTER
Contact: <sip:ua@[local_ip]:[local_port];transport=[transport]>;expires=3600
Max-Forwards: 70
User-Agent: SIPp/siphon-proxy-protocol-test
Content-Length: 0

]]>
  </send>

  <recv response="100" optional="true" />

  <!-- fix_nated_register() rewrote the REGISTER's Via from the address siphon
       believes the request came from, and the 200 echoes that Via back. So
       `received=` is this assertion, straight off the wire: behind the front it
       reads this caller's address, and reads 192.0.2.20 when the substitution
       never happened. No `^` anchor is involved, so the SIPp build's anchor
       limitation does not apply; a failed check_it fails the call, which is
       exactly the intent. -->
  <recv response="200">
    <action>
      <ereg regexp="received=192[.]0[.]2[.]30"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="register_via_received" />
      <ereg regexp="rport=[0-9]+"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="register_via_rport" />
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[
INVITE sip:ua@pbx.example SIP/2.0
Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
From: <sip:ua@pbx.example>;tag=[pid]SIPpTag01[call_number]
To: <sip:ua@pbx.example>
Call-ID: [call_id]
CSeq: 2 INVITE
Contact: <sip:ua@[local_ip]:[local_port];transport=[transport]>
Max-Forwards: 70
User-Agent: SIPp/siphon-proxy-protocol-test
Content-Type: application/sdp
Content-Length: [len]

v=0
o=ua 1 1 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 0
a=rtpmap:0 PCMU/8000
]]>
  </send>

  <recv response="100" optional="true" />

  <recv response="200">
    <action>
      <!-- The live request: request.source_ip must be the caller's. -->
      <ereg regexp=".*" search_in="hdr" header="X-Seen-Source:"
            assign_to="seen_source" />
      <ereg regexp="[[:space:]]*192[.]0[.]2[.]30[[:space:]]*$"
            search_in="hdr" header="X-Seen-Source:" check_it="true"
            assign_to="seen_source_expected" />
      <strcmp assign_to="seen_source_compared"
              variable="seen_source" variable2="seen_source_expected" />
      <test assign_to="seen_source_differs" variable="seen_source_compared"
            compare="not_equal" value="0" />

      <!-- The CIDR predicate scripts route on: it must match the caller's
           address, not the front's. -->
      <ereg regexp=".*" search_in="hdr" header="X-Seen-In-Ua-Range:"
            assign_to="in_range" />
      <ereg regexp="[[:space:]]*yes[[:space:]]*$"
            search_in="hdr" header="X-Seen-In-Ua-Range:" check_it="true"
            assign_to="in_range_expected" />
      <strcmp assign_to="in_range_compared"
              variable="in_range" variable2="in_range_expected" />
      <test assign_to="in_range_differs" variable="in_range_compared"
            compare="not_equal" value="0" />

      <!-- The stored registration's captured flow. The port is the caller's
           original source port, which this scenario cannot know, so the tail
           anchors the address and accepts any port. -->
      <ereg regexp=".*" search_in="hdr" header="X-Binding-Flow:"
            assign_to="binding_flow" />
      <ereg regexp="[[:space:]]*192[.]0[.]2[.]30:[0-9]+[[:space:]]*$"
            search_in="hdr" header="X-Binding-Flow:" check_it="true"
            assign_to="binding_flow_expected" />
      <strcmp assign_to="binding_flow_compared"
              variable="binding_flow" variable2="binding_flow_expected" />
      <test assign_to="binding_flow_differs" variable="binding_flow_compared"
            compare="not_equal" value="0" />

      <log message="seen=[$seen_source] in_range=[$in_range] flow=[$binding_flow]" />
    </action>
  </recv>

  <nop next="address_mismatch" test="seen_source_differs" />
  <nop next="address_mismatch" test="in_range_differs" />
  <nop next="address_mismatch" test="binding_flow_differs" />

  <send>
    <![CDATA[
ACK sip:ua@pbx.example SIP/2.0
Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
From: <sip:ua@pbx.example>;tag=[pid]SIPpTag01[call_number]
[last_To:]
Call-ID: [call_id]
CSeq: 2 ACK
Max-Forwards: 70
Content-Length: 0

]]>
  </send>

  <nop next="done" />

  <label id="address_mismatch" />
  <nop>
    <action>
      <log message="ADDRESS MISMATCH: siphon read the front's address, not the caller's" />
    </action>
  </nop>
  <!-- Nothing sends this; the timeout fails the call. -->
  <recv request="ADDRESS_MISMATCH" timeout="100" />

  <label id="done" />

  <Reference variables="seen_source_expected,in_range_expected,binding_flow_expected,register_via_received,register_via_rport" />

</scenario>
