<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  B2BUA replace_peer — Bob, the party being REPLACED:
  Receive INVITE → 180 → 200 → ACK
  → (stays up while carol rings)
  → receive BYE → 200

  Bob is released only once carol has answered, which is what separates this
  from a hangup-then-redial: for the whole of carol's ring Bob is still on the
  call and alice can still hear him. Bob is never told why he was hung up — the
  BYE is an ordinary one, and it goes through the real teardown, so `on_bye`,
  the CDR and the charging stop all fire for him.
-->
<scenario name="B2BUA replace_peer Bob UAS">

  <recv request="INVITE" crlf="true" />

  <send>
    <![CDATA[
SIP/2.0 180 Ringing
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:bob@[local_ip]:[local_port];transport=[transport]>
Content-Length: 0

]]>
  </send>

  <pause milliseconds="200" />

  <send retrans="500">
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:bob@[local_ip]:[local_port];transport=[transport]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=bob 53655765 2353687637 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 0 8 101
a=rtpmap:0 PCMU/8000
a=rtpmap:8 PCMA/8000
a=rtpmap:101 telephone-event/8000
a=fmtp:101 0-15
a=sendrecv
]]>
  </send>

  <recv request="ACK" optional="true" timeout="5000" />

  <!--
    The BYE arrives only after carol answered. A generous timeout on purpose:
    if siphon ever regressed to BYEing first, this would pass just as happily —
    what pins the ordering is alice's scenario, where the re-INVITE must arrive
    while this leg is still up.
  -->
  <recv request="BYE" timeout="20000" />

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

</scenario>
