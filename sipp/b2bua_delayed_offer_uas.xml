<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  B2BUA callee of a delayed-offer call (RFC 3261 §13.2.2.4, RFC 3264 §4).

  The INVITE siphon sends carries no offer, so this 200 carries it and the ACK
  siphon owes it must carry the answer: the caller's, from the caller's own
  ACK. An ACK without SDP fails the call here.
-->
<scenario name="B2BUA callee answering a delayed offer">

  <recv request="INVITE" crlf="true" />

  <send>
    <![CDATA[
SIP/2.0 180 Ringing
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:bob@[local_ip]:[local_port];transport=[transport]>
Content-Length: 0

]]>
  </send>

  <pause milliseconds="200" />

  <send retrans="500">
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:bob@[local_ip]:[local_port];transport=[transport]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=bob 53655765 2353687637 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 0 101
a=rtpmap:0 PCMU/8000
a=rtpmap:101 telephone-event/8000
a=fmtp:101 0-15
]]>
  </send>

  <recv request="ACK" timeout="10000" crlf="true">
    <action>
      <ereg regexp="application/sdp"
            search_in="hdr" header="Content-Type:" check_it="true"
            assign_to="ack_content_type" />
      <ereg regexp="m=audio [1-9][0-9]* RTP/AVP"
            search_in="msg" check_it="true"
            assign_to="ack_answer" />
      <log message="ACK carries the answer: [$ack_content_type] [$ack_answer]" />
    </action>
  </recv>

  <recv request="BYE" />

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

</scenario>
