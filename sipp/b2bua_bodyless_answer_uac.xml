<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  B2BUA answer after a preview: A-leg UAC that does not use 100rel.

  INVITE with an SDP offer (NO Supported: 100rel) → 100 → 183 with SDP,
  unreliable → 180 → 200 with SDP → ACK → BYE → 200

  The B-leg UAS (b2bua_bodyless_answer_uas.xml) gives its answer in a reliable
  183, which siphon PRACKs, and then sends its 200 without a body. On this
  dialog the 183 is unreliable, so its session description only previews the
  answer: RFC 3261 §13.2.1 wants the answer "in a reliable non-failure message",
  which here is the 200, and RFC 6337 §3.1.1 wants it to be "the same exact
  answer" the provisional showed.

  The scenario fails when the 200 carries no session description, or one whose
  o= line (session id and version) or m= line differs from the 183's.

  Pair with b2bua_bodyless_answer_uas.xml on the B-leg side of siphon.
-->
<scenario name="B2BUA answer after a preview UAC (no 100rel)">

  <send retrans="500">
    <![CDATA[
INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
From: <sip:alice@[local_ip]>;tag=[pid]SIPpTag00[call_number]
To: <sip:[service]@[remote_ip]>
Call-ID: [call_id]
CSeq: 1 INVITE
Contact: <sip:alice@[local_ip]:[local_port];transport=[transport]>
Max-Forwards: 70
User-Agent: SIPp/b2bua-no-100rel
Content-Type: application/sdp
Content-Length: [len]

v=0
o=alice 53655765 2353687637 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 0 8 101
a=rtpmap:0 PCMU/8000
a=rtpmap:8 PCMA/8000
a=rtpmap:101 telephone-event/8000
a=fmtp:101 0-15
]]>
  </send>

  <recv response="100" optional="true" />

  <!-- The preview: unreliable on this dialog, with the session description. -->
  <recv response="183" crlf="true">
    <action>
      <ereg regexp="100rel" search_in="hdr" header="Require:"
            check_it_inverse="true" assign_to="junk" />
      <ereg regexp="[0-9]+" search_in="hdr" header="RSeq:"
            check_it_inverse="true" assign_to="junk" />
      <ereg regexp="o=[^ ]+ [0-9]+ [0-9]+ IN IP4 [0-9.]+" search_in="msg"
            check_it="true" assign_to="preview_origin" />
      <ereg regexp="m=audio [0-9]+ RTP/AVP [0-9 ]+" search_in="msg"
            check_it="true" assign_to="preview_media" />
    </action>
  </recv>

  <recv response="180" optional="true" />

  <!-- The answer: the 200 carries the session description the 183 showed. -->
  <recv response="200" rtd="true" crlf="true">
    <action>
      <ereg regexp="application/sdp" search_in="hdr" header="Content-Type:"
            check_it="true" assign_to="junk" />
      <ereg regexp="o=[^ ]+ [0-9]+ [0-9]+ IN IP4 [0-9.]+" search_in="msg"
            check_it="true" assign_to="answer_origin" />
      <ereg regexp="m=audio [0-9]+ RTP/AVP [0-9 ]+" search_in="msg"
            check_it="true" assign_to="answer_media" />
      <strcmp assign_to="origin_differs" variable="preview_origin" variable2="answer_origin" />
      <test assign_to="origin_changed" variable="origin_differs" compare="not_equal" value="0" />
      <strcmp assign_to="media_differs" variable="preview_media" variable2="answer_media" />
      <test assign_to="media_changed" variable="media_differs" compare="not_equal" value="0" />
    </action>
  </recv>

  <nop condexec="origin_changed">
    <action>
      <error message="the 200 has o= [$answer_origin], the 183 previewed [$preview_origin]" />
    </action>
  </nop>
  <nop condexec="media_changed">
    <action>
      <error message="the 200 has [$answer_media], the 183 previewed [$preview_media]" />
    </action>
  </nop>

  <send>
    <![CDATA[
ACK sip:[service]@[remote_ip]:[remote_port] SIP/2.0
Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
From: <sip:alice@[local_ip]>;tag=[pid]SIPpTag00[call_number]
To: <sip:[service]@[remote_ip]>[peer_tag_param]
Call-ID: [call_id]
CSeq: 1 ACK
Max-Forwards: 70
Content-Length: 0

]]>
  </send>

  <pause milliseconds="500" />

  <send retrans="500">
    <![CDATA[
BYE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
From: <sip:alice@[local_ip]>;tag=[pid]SIPpTag00[call_number]
To: <sip:[service]@[remote_ip]>[peer_tag_param]
Call-ID: [call_id]
CSeq: 2 BYE
Max-Forwards: 70
Content-Length: 0

]]>
  </send>

  <recv response="200" rtd="true" />

</scenario>
