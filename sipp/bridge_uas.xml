<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  Callee side of the `bridge` acceptance test — the leg the control application
  places with `originate`, and the party the caller ends up talking to.

  recv INVITE (offerless) -> 180 -> (2 s) -> 200 (our offer) -> recv ACK (answer)
       -> re-INVITE #1 (the bridge)    -> 200 -> ACK -> [RTP]
       -> re-INVITE #2 (the unbridge)  -> 200 -> ACK
       -> re-INVITE #3 (the re-bridge) -> 200 -> ACK
       -> recv BYE -> 200

  Two things are asserted here that nothing on the application's rail can see:

    * the originate went out **offerless** and the answer came back on the ACK
      (RFC 3261 §13.2.2.4), which is what `media: true` means;
    * the final BYE. Nothing hangs this leg up: the application never sends a
      `hangup` for it, the caller hung up its own leg, and this BYE is the
      bridge's peer-hangup policy acting. A survivor left running would show up
      as this recv timing out.

  The two-second ring is deliberate. It is the window in which the application
  proves that bridging a leg that has not answered is refused `invalid_state`.
-->
<scenario name="bridge UAS">

  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="sip:\+15551000002@"
            search_in="hdr" header="To:" check_it="true" assign_to="to_ok" />
      <!-- `media: true` sends the INVITE with no offer: the callee offers in
           its 2xx and siphon answers locally on the ACK. An offer here would
           mean the anchor plan was never applied. -->
      <ereg regexp="m=audio"
            search_in="msg" check_it_inverse="true" assign_to="offerless" />
      <log message="originated INVITE: to=[$to_ok] offerless=[$offerless]" />
    </action>
  </recv>

  <send>
    <![CDATA[
SIP/2.0 180 Ringing
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:callee@[local_ip]:[local_port];transport=[transport]>
Content-Length: 0

]]>
  </send>

  <!-- Hold the answer: the application bridges into this window and must be
       refused, because a bridge renegotiates two *confirmed* dialogs. -->
  <pause milliseconds="2000" />

  <send retrans="500">
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:callee@[local_ip]:[local_port];transport=[transport]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=callee 53655765 2353687637 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 8 101
a=rtpmap:8 PCMA/8000
a=rtpmap:101 telephone-event/8000
a=fmtp:101 0-15
a=ptime:30
]]>
  </send>

  <!-- RFC 3261 §13.2.2.4: the answer to our 2xx offer rides on the ACK, and it
       is the engine's, because the leg was placed with `media: true`. -->
  <recv request="ACK" rtd="true" crlf="true">
    <action>
      <ereg regexp="c=IN IP4 172\.20\.0\.130"
            search_in="body" check_it="true" assign_to="answer_on_ack" />
      <log message="answer rode the ACK, anchored on the engine: [$answer_on_ack]" />
    </action>
  </recv>

  <!-- #1: the bridge re-offers this leg onto the pair's engine call. -->
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="c=IN IP4 172\.20\.0\.130"
            search_in="body" check_it="true" assign_to="bridge_anchored" />
      <ereg regexp="a=sendonly"
            search_in="body" check_it_inverse="true" assign_to="bridge_not_held" />
      <log message="bridge re-INVITE: anchored=[$bridge_anchored] not_held=[$bridge_not_held]" />
    </action>
  </recv>

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:callee@[local_ip]:[local_port];transport=[transport]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=callee 53655765 2353687638 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 8
a=rtpmap:8 PCMA/8000
a=ptime:30
]]>
  </send>

  <recv request="ACK" rtd="true" />

  <nop>
    <action>
      <exec play_pcap_audio="/sipp/g711a.pcap" />
    </action>
  </nop>

  <!-- #2: the unbridge holds this leg too. -->
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="a=sendonly"
            search_in="body" check_it="true" assign_to="held" />
      <log message="unbridge re-INVITE holds the leg: [$held]" />
    </action>
  </recv>

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:callee@[local_ip]:[local_port];transport=[transport]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=callee 53655765 2353687639 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 8
a=rtpmap:8 PCMA/8000
a=ptime:30
a=recvonly
]]>
  </send>

  <recv request="ACK" rtd="true" />

  <!-- #3: joined again. -->
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="c=IN IP4 172\.20\.0\.130"
            search_in="body" check_it="true" assign_to="rebridge_anchored" />
      <ereg regexp="a=sendonly"
            search_in="body" check_it_inverse="true" assign_to="rebridge_not_held" />
      <log message="re-bridge re-INVITE: anchored=[$rebridge_anchored] not_held=[$rebridge_not_held]" />
    </action>
  </recv>

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:callee@[local_ip]:[local_port];transport=[transport]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=callee 53655765 2353687640 IN IP[local_ip_type] [local_ip]
s=-
c=IN IP[media_ip_type] [media_ip]
t=0 0
m=audio [media_port] RTP/AVP 8
a=rtpmap:8 PCMA/8000
a=ptime:30
]]>
  </send>

  <recv request="ACK" rtd="true" />

  <!-- The peer-hangup policy: the caller left, so siphon ends this leg too.
       Nothing else sends a BYE here. -->
  <recv request="BYE" />

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

</scenario>
