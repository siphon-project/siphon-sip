<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- A parallel-fork branch that redirects the call (sipp/b2bua-fork/b2bua_fork.py).

     Its 302 carries the address the callee can be reached at instead. That
     Contact is the whole content of a redirect (RFC 3261 §8.1.3.4, §21.3), so it
     is what the caller must receive, not siphon's own address. The ACK row is
     §17.1.1.3. -->

<scenario name="B2BUA fork branch that redirects">

  <recv request="INVITE" />

  <send>
    <![CDATA[
SIP/2.0 302 Moved Temporarily
[last_Via:]
[last_From:]
[last_To:];tag=[pid]SIPpTag01[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:elsewhere@198.51.100.30:5060>
Content-Length: 0

]]>
  </send>

  <recv request="ACK" crlf="true" />

</scenario>
